# ============================================
# Monorepo Puntazo — app/ + firmware/ + docs/
# ============================================

# ---- Genérico ----
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# ---- IntelliJ / Android Studio ----
*.iml
*.ipr
*.iws
.idea/

# El directorio .vscode contiene launch configs y tasks que puede que
# quieras versionar; descomenta para ignorarlo.
#.vscode/

# ---- app/ : Flutter / Dart ----
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
app/build/
app/android/app/debug
app/android/app/profile
app/android/app/release
app/android/app/.cxx/

# Symbolication / ofuscación
app.*.symbols
app.*.map.json

# ---- firmware/ : Arduino / PlatformIO ----
# Arduino IDE compila fuera del sketch, pero exports y PlatformIO sí ensucian.
firmware/**/build/
firmware/**/.pio/
firmware/**/*.bin
firmware/**/*.elf
firmware/**/*.hex
firmware/**/*.map

# ---- tools/ ----
tools/__pycache__/
tools/.venv/

# ---- Restos de la estructura anterior (Flutter estaba en la raiz) ----
# Artefactos regenerables; se pueden borrar sin riesgo.
/build/
/.dart_tool/
/.flutter-plugins
/.flutter-plugins-dependencies
