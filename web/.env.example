# Copia este fichero a .env.local y rellena los tres valores.
# Panel de Supabase > Project Settings > API

# Público: viaja al navegador. No pasa nada, sólo sirve para hablar con la API
# respetando las políticas RLS.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRETO: se salta RLS por completo. Sólo se usa en el servidor para crear
# usuarios desde /admin. Nunca lo pongas en una variable NEXT_PUBLIC_ ni lo
# subas al repositorio.
SUPABASE_SERVICE_ROLE_KEY=
